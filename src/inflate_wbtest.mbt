fn inflate_bytes_of(ints : Array[Int]) -> Bytes {
  let buf = @buffer.new(size_hint=ints.length())
  for i in ints {
    buf.write_byte(i.to_byte())
  }
  buf.to_bytes()
}

test "inflate short_raw" {
  let compressed = inflate_bytes_of([
    203, 72, 205, 201, 201, 7, 0])

  let expected = inflate_bytes_of([
    104, 101, 108, 108, 111])

  let decoded = inflate(compressed, 10_000_000).unwrap()
  assert_eq(decoded.length(), expected.length())
  assert_eq(decoded, expected)
}

test "inflate short_zlib" {
  let compressed = inflate_bytes_of([
    120, 218, 203, 72, 205, 201, 201, 7, 0, 6, 44, 2, 21])

  let expected = inflate_bytes_of([
    104, 101, 108, 108, 111])

  let decoded = inflate(compressed, 10_000_000).unwrap()
  assert_eq(decoded.length(), expected.length())
