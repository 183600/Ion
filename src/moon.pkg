import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/list",
  "moonbitlang/core/string",
}

options(
  name: "feather",
  is_main: true,
  "native-stub": ["tcp_native_stub.c", "tls_native_stub.c"],
  targets: {
    "native_tcp.mbt": ["native"],
    "native_tls.mbt": ["native"],
  },
  link: {
    "native": {
      "cc-link-flags": "-lssl -lcrypto",
    },
  },
)
