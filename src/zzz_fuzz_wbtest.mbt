test "inflate differential corpus" {
  assert_true(fuzz_cases.length() > 0)
  let mut line_no = 0
  for line in fuzz_cases {
    line_no = line_no + 1
    let parts = line.split("|").collect()
    assert_eq(parts.length(), 3)
    let kind = parts[0].to_owned()
    let compressed = fuzz_hex(parts[1].to_owned())
    let expected = fuzz_hex(parts[2].to_owned())
    let decoded = match kind {
      "gzip" => gunzip(compressed, 1000000)
      "zlib" | "raw" => inflate(compressed, 1000000)
      _ => fail("unknown fuzz kind " + kind)
    }
    match decoded {
      Ok(decoded) =>
        if decoded != expected {
          fail(
            "mismatch line " +
            line_no.to_string() +
            " kind " +
            kind +
            " got " +
            decoded.length().to_string() +
            " expected " +
            expected.length().to_string(),
          )
        }
      Err(err) =>
        fail(
          "error line " + line_no.to_string() + " kind " + kind + " " + @debug.to_string(err),
        )
    }
  }
}
