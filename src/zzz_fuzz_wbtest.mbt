/// Self-contained differential corpus for the inflate implementation. The
/// cases were generated with a reference DEFLATE encoder and cover stored,
/// fixed-Huffman and dynamic-Huffman blocks wrapped as raw DEFLATE, zlib and
/// gzip streams.

fn fuzz_hex(text : String) -> Bytes {
  let out = Buffer(size_hint=text.length() / 2)
  let mut i = 0
  while i + 1 < text.length() {
    let hi = text.get_char(i).unwrap()
    let lo = text.get_char(i + 1).unwrap()
    let mut h = 0
    let mut l = 0
    if hi >= '0' && hi <= '9' {
      h = hi.to_int() - '0'.to_int()
    } else if hi >= 'a' && hi <= 'f' {
      h = hi.to_int() - 'a'.to_int() + 10
    } else if hi >= 'A' && hi <= 'F' {
      h = hi.to_int() - 'A'.to_int() + 10
    }
    if lo >= '0' && lo <= '9' {
      l = lo.to_int() - '0'.to_int()
    } else if lo >= 'a' && lo <= 'f' {
      l = lo.to_int() - 'a'.to_int() + 10
    } else if lo >= 'A' && lo <= 'F' {
      l = lo.to_int() - 'A'.to_int() + 10
    }
    out.write_byte((h * 16 + l).to_byte())
    i = i + 2
  }
  out.to_bytes()
}

