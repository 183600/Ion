///|
test "tmp idna differential" {
  assert_eq(
    idna_host_to_ascii("\u{1bf}\u{29a}\u{1a5}\u{198b}"),
    Some("xn--nia5c21b452e"),
  )
  assert_eq(idna_host_to_ascii("\u{1895}0"), Some("xn--0-kck"))
  assert_eq(
    idna_host_to_ascii("\u{a86}\u{25e}\u{198d}\u{7fa}"),
    Some("xn--xna68z37by5y"),
  )
  assert_eq(
    idna_host_to_ascii("\u{2fc2}\u{1675}a\u{2152}"),
    Some("xn--a-hgjy45dlqo"),
  )
  assert_eq(
    idna_host_to_ascii("\u{144d}\u{b6f}\u{1621}"),
